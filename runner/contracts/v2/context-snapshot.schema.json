{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "packageHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string"
    },
    "consumedCount": {
      "type": "integer",
      "minimum": 0
    },
    "validity": {
      "enum": [
        "valid",
        "stale"
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "2.0.0"
        },
        "snapshotId": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "role": {
          "enum": [
            "specification",
            "architect",
            "developer",
            "qa",
            "review-correctness",
            "review-architecture",
            "review-security",
            "review-testing",
            "finding-verifier",
            "approval"
          ]
        },
        "goal": {
          "type": "string"
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "referenceCommit": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}([a-f0-9]{24})?)?$"
        },
        "knowledgeCommit": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}([a-f0-9]{24})?)?$"
        },
        "globalCommit": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}([a-f0-9]{24})?)?$"
        },
        "contractsVersion": {
          "const": "2.0.0"
        },
        "budgetTokens": {
          "type": "integer",
          "minimum": 512,
          "maximum": 200000
        },
        "estimatedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "budgetMethod": {
          "const": "utf8-byte-upper-bound"
        },
        "sourceTrust": {
          "const": "context-only"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "scopeId": {
                "type": "string",
                "format": "uuid"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180,
                "pattern": "^[a-z0-9][a-z0-9/_-]*\\.md$"
              },
              "ruleKind": {
                "enum": [
                  "mandatory",
                  "recommendation",
                  "example"
                ]
              },
              "version": {
                "type": "integer",
                "minimum": 0
              },
              "revisionId": {
                "type": "string"
              },
              "commit": {
                "type": "string",
                "pattern": "^([a-f0-9]{40}([a-f0-9]{24})?)?$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^([a-f0-9]{64})?$"
              },
              "content": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "unpublished",
                  "official",
                  "stale"
                ]
              }
            },
            "required": [
              "id",
              "scopeId",
              "title",
              "category",
              "path",
              "ruleKind",
              "version",
              "revisionId",
              "commit",
              "sha256",
              "content",
              "state"
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "snapshotId",
        "projectId",
        "taskId",
        "role",
        "goal",
        "restrictions",
        "referenceCommit",
        "knowledgeCommit",
        "globalCommit",
        "contractsVersion",
        "budgetTokens",
        "estimatedTokens",
        "budgetMethod",
        "sourceTrust",
        "documents"
      ]
    }
  },
  "required": [
    "id",
    "projectId",
    "taskId",
    "packageHash",
    "createdAt",
    "consumedCount",
    "validity",
    "package"
  ]
}
