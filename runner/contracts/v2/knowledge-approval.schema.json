{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "proposalId": {
      "type": "string",
      "format": "uuid"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "required": [
    "proposalId",
    "decision",
    "expectedVersion",
    "reason"
  ]
}
