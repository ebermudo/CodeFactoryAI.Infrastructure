{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "proposalId": {
      "type": "string",
      "format": "uuid"
    },
    "commit": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}([a-f0-9]{24})?)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^([a-f0-9]{64})?$"
    },
    "createdAt": {
      "type": "string"
    },
    "author": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "documentId",
    "proposalId",
    "commit",
    "sha256",
    "createdAt",
    "author"
  ]
}
