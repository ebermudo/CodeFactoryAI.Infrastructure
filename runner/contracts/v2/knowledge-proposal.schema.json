{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "scopeId": {
      "type": "string",
      "format": "uuid"
    },
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "baseRevision": {
      "type": "string"
    },
    "baseCommit": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "maxLength": 200000
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "executionId": {
      "type": "string"
    },
    "state": {
      "enum": [
        "proposed",
        "validated",
        "approved",
        "rejected",
        "promoting",
        "promoted",
        "conflict"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "diff": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "scopeId",
    "documentId",
    "baseRevision",
    "baseCommit",
    "body",
    "reason",
    "evidence",
    "risks",
    "author",
    "executionId",
    "state",
    "version",
    "diff",
    "createdAt"
  ]
}
