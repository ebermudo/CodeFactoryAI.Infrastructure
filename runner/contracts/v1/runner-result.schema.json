{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunnerResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attemptId",
    "state",
    "reason"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "attemptId": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "disabled",
        "unavailable",
        "unauthenticated",
        "quota-blocked",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "unknown"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
